# Copy your .env from DocAnswer, then check it has every name below.
# Values for the model names are in the kit's models.md. Never put a key in this file.
GEMINI_API_KEY=
CHAT_MODEL=
EMBED_MODEL=
CHUNK_MAX_WORDS=
CHUNK_OVERLAP=

# Optional settings. Remove the # only when you give a value:
# an empty value is not the same as no value.
# Task 8. Default calendar.json; task 16 points it at attacks/calendar.json.
# CALENDAR_FILE=
# Task 8. Default localhost; inside Compose (task 18) it is mailpit.
# SMTP_HOST=
# Task 8. Default 1025.
# SMTP_PORT=
# Task 16. The Chroma collection search_docs uses, such as handbook-attacks.
# DOCS_COLLECTION=
# Task 17. 0 turns the model-call cache off.
# TASKPILOT_CACHE=
# Task 17. The model for this run; falls back to CHAT_MODEL. Usually set in the shell.
# TASKPILOT_MODEL=
