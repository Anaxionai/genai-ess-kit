# Secrets: your Gemini API key lives in .env and never goes to Git
.env
.env.*
!.env.example

# Made when you run the kit's scripts inside the kit
__pycache__/
*.pyc
.pytest_cache/
.venv/
node_modules/

# Vector stores and local databases
chroma/
*.sqlite3
*.db

# Data files that the kit's generators write when you run them in the kit's own folders
data/tickets/tickets*.csv
data/tickets/out/
capstone/data/out/
mailpit/data/
